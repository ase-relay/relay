generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. Model User & Autentikasi (FR-REG-01, FR-LGN-01)
enum Role {
  USER
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  searchHistories SearchHistory[]
}

// 2. Model Moda Transportasi (FR-ADM-04)
// Contoh: Bus (TMB/TMP), Angkot, Kereta (KRD), Ojol
model ModaTransportasi {
  id                   Int      @id @default(autoincrement())
  namaModa             String   @unique // Bus, Angkot, Kereta, Ojek Online
  tipeModa             String? // BRT, FEEDEER, COMMUTER_TRAIN, RIDE_HAILING
  ikon                 String? // URL atau nama identifier icon SVG
  deskripsi            String?
  // ESTIMASI kecepatan rata-rata (km/jam) untuk perhitungan durasi mesin routing.
  // Null = pakai konstanta default di src/config/routing.config.ts.
  rataRataKecepatanKmh Float?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  rutes  Rute[]
  tarif Tarif?
}

// 3. Model Halte / Titik Pemberhentian (FR-ADM-03, FR-USR-04)
// Titik transit dan halte di wilayah Bandung & Cimahi
model Halte {
  id        Int      @id @default(autoincrement())
  namaHalte String
  latitude  Float
  longitude Float
  alamat    String?
  kota      String   @default("Bandung") // Bandung, Cimahi, Kab. Bandung, dll
  isTransit Boolean  @default(false) // Apakah titik hubung transit antar moda
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ruteStops RuteStop[]
}

// 4. Model Rute Transportasi (FR-ADM-02, FR-USR-02)
model Rute {
  id        Int      @id @default(autoincrement())
  namaRute  String // Contoh: "Koridor 1: Cibiru - Elang" atau "Stasiun Hall - Cimahi"
  kodeRute  String? // Contoh: "K1", "KRD-BDG-CMH"
  deskripsi String?
  modaId    Int
  jamMulaiOperasi String? // Contoh: "04:30"
  jamSelesaiOperasi String? // Contoh: "20:00"
  intervalWaktu String? // Contoh: "15-20 menit"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moda   ModaTransportasi @relation(fields: [modaId], references: [id], onDelete: Cascade)
  stops  RuteStop[]
}

// 5. Junction Model: Urutan Halte dalam Rute (FR-USR-04, FR-USR-05)
model RuteStop {
  id            Int      @id @default(autoincrement())
  ruteId        Int
  halteId       Int
  urutan        Int // Urutan stop: 1, 2, 3, dst.
  estimasiMenit Int? // Estimasi menit ke stop berikutnya
  jarakMeter    Int? // Estimasi jarak meter ke stop berikutnya
  jadwalKeberangkatan String[] @default([]) // Array jadwal keberangkatan, contoh: ["05:10", "06:20"]
  // Geometri jalur dari halte ini ke halte berikutnya (searah urutan rute).
  // Format: [[lat, lng], ...] pre-computed dari Overpass API (jalur rel asli).
  // Null = geometri belum tersedia; fallback ke OSRM / garis lurus.
  geometri      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rute  Rute  @relation(fields: [ruteId], references: [id], onDelete: Cascade)
  halte Halte @relation(fields: [halteId], references: [id], onDelete: Cascade)

  @@unique([ruteId, urutan])
  @@unique([ruteId, halteId])
}

// 6. Model Tarif Transportasi (FR-ADM-01, FR-USR-03)
enum TipeTarif {
  FLAT // Tarif tetap jauh-dekat (Contoh: Bus Rp 4.900, Angkot Rp 5.000)
  PER_KM // Tarif berbasis jarak (Contoh: Ojol Rp 2.500 / km)
}

model Tarif {
  id             Int       @id @default(autoincrement())
  modaId         Int       @unique
  tipeTarif      TipeTarif @default(FLAT)
  nominalDasar   Float     @default(0) // Base fare / tarif minimum (jarak <= jarakMinimumKm)
  nominalPerKm   Float?    @default(0) // Biaya per km jika tipe PER_KM
  // Khusus tipe PER_KM (mis. ojek): jarak maksimum yang ditutup nominalDasar.
  // Null/0 = nominalDasar berlaku sebagai tarif dasar biasa.
  jarakMinimumKm Float?
  biayaLayanan   Float     @default(0)
  keterangan     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  moda ModaTransportasi @relation(fields: [modaId], references: [id], onDelete: Cascade)
}

// 7. Model Riwayat Pencarian Pengguna (FR-USR-01)
model SearchHistory {
  id             Int      @id @default(autoincrement())
  userId         Int?
  originName     String
  originLat      Float?
  originLng      Float?
  destName       String
  destLat        Float?
  destLng        Float?
  selectedRuteId Int?
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}
