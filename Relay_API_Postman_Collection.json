{
  "info": {
    "_postman_id": "relay-multimodal-routing-api",
    "name": "Relay - Multi-Modal Routing API",
    "description": "Dokumentasi & Test Suite API Backend Relay (Tubes ASE). Mencakup endpoint publik, routing engine, turn-by-turn walking steps, dan CRUD Admin Transport.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8010/api",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health & General",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "Public Moda List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/moda",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "moda"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Auth (Admin & Pengguna)",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"testuser@telkomuniversity.ac.id\", \"password\": \"Password123!\", \"nama\": \"Test User\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"admin@relay.id\", \"password\": \"adminpassword\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Core Routing Engine (Pencarian Rute Multi-Modal)",
      "item": [
        {
          "name": "Cari Rute (Standard Telkom -> Alun-Alun)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": {\n    \"lat\": -6.974,\n    \"lng\": 107.6303\n  },\n  \"destination\": {\n    \"lat\": -6.9219,\n    \"lng\": 107.6071\n  },\n  \"sortBy\": \"RECOMMENDED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/routing/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "routing",
                "search"
              ]
            }
          }
        },
        {
          "name": "Edge Case 1: Jarak Sangat Dekat (<50m walking)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": {\n    \"lat\": -6.974,\n    \"lng\": 107.6303\n  },\n  \"destination\": {\n    \"lat\": -6.9742,\n    \"lng\": 107.6304\n  },\n  \"sortBy\": \"FASTEST\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/routing/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "routing",
                "search"
              ]
            }
          }
        },
        {
          "name": "Edge Case 2: Filter Khusus Moda (allowedModa)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": {\n    \"lat\": -6.974,\n    \"lng\": 107.6303\n  },\n  \"destination\": {\n    \"lat\": -6.9147,\n    \"lng\": 107.6098\n  },\n  \"allowedModa\": [\n    \"BUS\",\n    \"KERETA\"\n  ],\n  \"sortBy\": \"CHEAPEST\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/routing/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "routing",
                "search"
              ]
            }
          }
        },
        {
          "name": "Edge Case 3: Lokasi Terpencil / No Transit (Fallback Ojek Langsung)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": {\n    \"lat\": -7.1,\n    \"lng\": 107.5\n  },\n  \"destination\": {\n    \"lat\": -7.12,\n    \"lng\": 107.52\n  },\n  \"sortBy\": \"FASTEST\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/routing/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "routing",
                "search"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Public Transport Data",
      "item": [
        {
          "name": "Get Halte Terdekat (Nearby)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transport/halte/nearby?lat=-6.9740&lng=107.6303&radiusMeters=1500",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transport",
                "halte",
                "nearby"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "-6.9740"
                },
                {
                  "key": "lng",
                  "value": "107.6303"
                },
                {
                  "key": "radiusMeters",
                  "value": "1500"
                }
              ]
            }
          }
        },
        {
          "name": "Get Detail Rute by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rute/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rute",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Admin Transport Management",
      "item": [
        {
          "name": "Admin - List Semua Tarif",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transport/tarif",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transport",
                "tarif"
              ]
            }
          }
        },
        {
          "name": "Admin - Update Tarif Moda",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipeTarif\": \"PER_KM\",\n  \"nominalDasar\": 8000,\n  \"nominalPerKm\": 2500,\n  \"jarakMinimumKm\": 4,\n  \"biayaLayanan\": 1000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transport/tarif/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transport",
                "tarif",
                "1"
              ]
            }
          }
        }
      ]
    }
  ]
}